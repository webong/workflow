{
    "name": "webong/workflow",
    "description": "Framework-agnostic workflow definitions, state evaluation, presentations, and actions.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3 || ^8.4 || ^8.5"
    },
    "require-dev": {
        "guzzlehttp/psr7": "^3.2",
        "illuminate/redis": "^12.0",
        "justinrainbow/json-schema": "^5.2",
        "paneon/php-to-typescript": "^2.3",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^12.0",
        "webong/composer-source-plugin": "^0.5",
        "webong/workflow-jq": "@dev",
        "webong/workflow-laravel": "@dev",
        "webong/workflow-open-workflow": "@dev",
        "webong/workflow-temporal": "@dev"
    },
    "autoload": {
        "psr-4": {
            "Webong\\WorkFlow\\": "src/",
            "Webong\\WorkFlow\\Examples\\Standalone\\": "examples/standalone/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Webong\\WorkFlow\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/workflow"
    ],
    "extra": {
        "source-plugin": {
            "surfaces": [
                "composer.surface.json",
                "src/composer.json",
                "types/composer.json",
                "docs/composer.json"
            ]
        },
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit --testdox",
        "types": [
            "php tools/generate-types.php",
            "php tools/generate-clients.php"
        ],
        "analyse": "vendor/bin/phpstan analyse --no-progress --memory-limit=512M",
        "test:projections": "bash tests/integration/composer-surfaces.sh",
        "package:composer": "php tools/package-composer.php"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "webong/composer-source-plugin": true
        },
        "policy": {
            "advisories": {
                "ignore-id": [
                    "PKSA-tcfz-w4fm-hhk9 PKSA-xbp4-qwr2-cbjj"
                ]
            }
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "pkg/*",
            "options": {
                "symlink": true,
                "versions": {
                    "webong/workflow-laravel": "dev-main",
                    "webong/workflow-open-workflow": "dev-main",
                    "webong/workflow-temporal": "dev-main",
                    "webong/workflow-jq": "dev-main"
                }
            }
        }
    ]
}
