{
    "name": "webong/work-flow",
    "description": "Framework-agnostic workflow definitions, state evaluation, presentations, and actions.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3 || ^8.4 || ^8.5"
    },
    "require-dev": {
        "illuminate/cache": "^12.0",
        "illuminate/database": "^12.0",
        "illuminate/redis": "^12.0",
        "paneon/php-to-typescript": "^2.3",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^12.0"
    },
    "suggest": {
        "illuminate/cache": "Required to use the optional Laravel Redis WorkFlow store.",
        "illuminate/database": "Required to use the optional Laravel Eloquent WorkFlow store.",
        "illuminate/support": "Required to register the optional Laravel WorkFlow service provider."
    },
    "autoload": {
        "psr-4": {
            "Webong\\WorkFlow\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Webong\\WorkFlow\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Webong\\WorkFlow\\Laravel\\WorkFlowServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit --testdox",
        "types": "php tools/generate-types.php",
        "analyse": "vendor/bin/phpstan analyse --no-progress --memory-limit=512M"
    },
    "config": {
        "sort-packages": true
    }
}
