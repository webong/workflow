{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "WorkFlow condition v1",
    "description": "Structural shape only. Use condition authoring validation for rule parameters, jq support, byte limits and global tree limits. Predicates still require runtime data to produce a boolean.",
    "$ref": "#/definitions/condition",
    "definitions": {
        "condition": {
            "oneOf": [
                {
                    "type": "object",
                    "properties": {
                        "version": {
                            "enum": [
                                "v1"
                            ]
                        },
                        "all": {
                            "type": "array",
                            "minItems": 1,
                            "maxItems": 64,
                            "items": {
                                "$ref": "#/definitions/condition"
                            }
                        }
                    },
                    "required": [
                        "all"
                    ],
                    "additionalProperties": false
                },
                {
                    "type": "object",
                    "properties": {
                        "version": {
                            "enum": [
                                "v1"
                            ]
                        },
                        "any": {
                            "type": "array",
                            "minItems": 1,
                            "maxItems": 64,
                            "items": {
                                "$ref": "#/definitions/condition"
                            }
                        }
                    },
                    "required": [
                        "any"
                    ],
                    "additionalProperties": false
                },
                {
                    "type": "object",
                    "properties": {
                        "version": {
                            "enum": [
                                "v1"
                            ]
                        },
                        "not": {
                            "$ref": "#/definitions/condition"
                        }
                    },
                    "required": [
                        "not"
                    ],
                    "additionalProperties": false
                },
                {
                    "type": "object",
                    "properties": {
                        "version": {
                            "enum": [
                                "v1"
                            ]
                        },
                        "syntax": {
                            "enum": [
                                "rules"
                            ]
                        },
                        "rules": {
                            "anyOf": [
                                {
                                    "type": "object",
                                    "maxProperties": 64,
                                    "additionalProperties": {
                                        "oneOf": [
                                            {
                                                "type": "string",
                                                "minLength": 1
                                            },
                                            {
                                                "type": "array",
                                                "minItems": 1,
                                                "maxItems": 16,
                                                "items": {
                                                    "type": "string",
                                                    "minLength": 1,
                                                    "maxLength": 1024
                                                }
                                            }
                                        ]
                                    }
                                },
                                {
                                    "type": "array",
                                    "maxItems": 0
                                }
                            ],
                            "x-allowed-rules": [
                                "accepted",
                                "array",
                                "bail",
                                "between",
                                "boolean",
                                "declined",
                                "ends_with",
                                "filled",
                                "in",
                                "integer",
                                "list",
                                "max",
                                "min",
                                "not_in",
                                "nullable",
                                "numeric",
                                "present",
                                "required",
                                "size",
                                "starts_with",
                                "string"
                            ],
                            "x-max-field-bytes": 512
                        }
                    },
                    "required": [
                        "rules"
                    ],
                    "additionalProperties": false
                },
                {
                    "type": "object",
                    "properties": {
                        "version": {
                            "enum": [
                                "v1"
                            ]
                        },
                        "syntax": {
                            "enum": [
                                "jq"
                            ]
                        },
                        "expression": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 8192
                        }
                    },
                    "required": [
                        "syntax",
                        "expression"
                    ],
                    "additionalProperties": false
                }
            ]
        }
    },
    "x-max-depth": 32,
    "x-max-nodes": 256
}
